[Unit]
Description=Tau daemon with integrated Rust coding agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root
Environment=HOME=/root
Environment=RUST_LOG=info
Environment=TAU_CWD=/root
Environment=TAU_DATABASE_PATH=/var/lib/tau/tau.sqlite3
Environment=TAU_TELEMETRY_PATH=/var/lib/tau/client-crashes.jsonl
Environment=TAU_SETTINGS_PATH=/var/lib/tau/settings.json
Environment=TAU_ATTACHMENT_ROOT=/root/.local/share/tau/outbox
Environment=TAU_UPLOAD_ROOT=/root/.local/share/tau/uploads
EnvironmentFile=/etc/tau.env
ExecStart=/usr/local/bin/taud
Restart=on-failure
RestartSec=5s
TimeoutStopSec=75s
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
