+//! Temporary review probes: assertions describe the desired behavior.
+use super::*;
+use crate::app::{App, PlatformAction, SavedAction, Store};
+use chad::{Config, HeadlessCtx};
+use std::sync::Arc;
+
+struct Harness {
+    app: App,
+    ctx: HeadlessCtx,
+    dir: tempfile::TempDir,
+}
+impl Harness {
+    fn new() -> Self {
+        let dir = tempfile::tempdir().unwrap();
+        let ctx = HeadlessCtx::new(&Config {
+            size: (1000, 800),
+            device_limits: crate::desktop::limits(),
+            ..Default::default()
+        }).unwrap();
+        let mut app = App::new(&ctx, Store::open(dir.path().into()).unwrap(), Arc::new(|| {}), false).unwrap();
+        app.back();
+        crate::demo::populate(&mut app.controller).unwrap();
+        app.tick(0.);
+        app.root.workspace.show_chats = false;
+        Self { app, ctx, dir }
+    }
+    fn frame(&mut self) {
+        self.app.frame(&self.ctx, self.ctx.view());
+    }
+    fn dump(&self, name: &str) {
+        if let Some(dir) = std::env::var_os("TAU_REVIEW_PREVIEW_DIR") {
+            std::fs::create_dir_all(&dir).unwrap();
+            image::save_buffer(std::path::PathBuf::from(dir).join(name), &self.ctx.read_rgba8().unwrap(),
+                1000, 800, image::ColorType::Rgba8).unwrap();
+        }
+    }
+    fn saved_attachment(&mut self) -> (Target, sanscale::Rect, sanscale::Rect) {
+        use tau_protocol::*;
+        let mut event = self.app.controller.chats["demo"].feed.events.values().next().unwrap().clone();
+        event.id = "review-file".into();
+        event.entry_id = event.id.clone();
+        event.order = 1;
+        event.text.clear();
+        event.attachment = Some(ChatAttachment {
+            source_path: None, kind: AttachmentKind::File, file_name: "saved.txt".into(), caption: None, size: Some(13),
+        });
+        let path = self.dir.path().join("saved.txt");
+        std::fs::write(&path, b"already saved").unwrap();
+        self.app.controller.record_download(&self.app.controller.identity.clone(), "", "demo", "review-file",
+            crate::store::SavedDownload {
+                reference: path.to_string_lossy().into(), location: "Downloads/Tau".into(), mime_type: "text/plain".into(),
+            }).unwrap();
+        let chat = self.app.controller.chats.get_mut("demo").unwrap();
+        chat.feed.events.clear();
+        chat.feed.events.insert(1, event);
+        self.frame();
+        let row = self.app.root.workspace.chat.transcript.rows.iter().find(|r| r.attachment.is_some()).unwrap();
+        let card = row.attachment.as_ref().unwrap();
+        let (_, button, _) = card.controls.items.iter().find(|(_, _, choice)|
+            matches!(choice, attachments::CardChoice::UseSaved(_, _, SavedAction::Open))).unwrap();
+        (button.control.target, button.control.rect.unwrap(), row.control.rect.unwrap())
+    }
+}
+fn center(r: sanscale::Rect) -> sanscale::Vec2 {
+    sanscale::Vec2::new(r.x + r.width / 2., r.y + r.height / 2.)
+}
+fn pixel(image: &[u8], p: sanscale::Vec2) -> [u8; 4] {
+    let offset = (p.y as usize * 1000 + p.x as usize) * 4;
+    image[offset..offset + 4].try_into().unwrap()
+}
+
+#[test]
+fn review_opaque_dialog_covers_workspace_text_and_icons() {
+    let mut h = Harness::new();
+    h.app.open_ui(DialogSpec::Connection).unwrap();
+    h.frame();
+    h.dump("opaque-dialog.png");
+    let image = h.ctx.read_rgba8().unwrap();
+    let background = pixel(&image, sanscale::Vec2::new(2., 2.));
+    let mut visible = 0;
+    // Outside the centered dialog content, exactly where the sidebar's Tau label was.
+    for y in 20..60 {
+        for x in 16..70 {
+            visible += usize::from(pixel(&image, sanscale::Vec2::new(x as f32, y as f32)) != background);
+        }
+    }
+    assert_eq!(visible, 0, "workspace text must not be drawn on top of an opaque dialog");
+}
+
+#[test]
+fn review_attachment_hover_does_not_highlight_parent_row() {
+    let mut h = Harness::new();
+    let (target, button, row) = h.saved_attachment();
+    let sample = sanscale::Vec2::new(row.x + 8., row.y + 20.);
+    let before = pixel(&h.ctx.read_rgba8().unwrap(), sample);
+    h.dump("attachment-idle.png");
+    h.app.hover(Some(center(button)));
+    assert_eq!(h.app.ui.hot.map(|(t, _)| t), Some(target));
+    h.frame();
+    h.dump("attachment-hover.png");
+    let after = pixel(&h.ctx.read_rgba8().unwrap(), sample);
+    assert_eq!(before, after, "only the retained hot control, not the enclosing panel, should highlight");
+}
+
+#[test]
+fn review_attachment_press_does_not_start_parent_ripple() {
+    let mut h = Harness::new();
+    let (target, button, _) = h.saved_attachment();
+    h.app.press(1, center(button), false);
+    assert_eq!(h.app.ui.capture.unwrap().target, target);
+    assert!(h.app.root.workspace.chat.transcript.rows.iter().all(|r| r.ripple.is_none()),
+        "a consumed child press must not start the parent's click feedback");
+}
+
+#[test]
+fn review_attachment_primary_click_emits_only_its_own_action() {
+    let mut h = Harness::new();
+    let (_, button, _) = h.saved_attachment();
+    h.app.press(1, center(button), false);
+    h.app.release(1, center(button));
+    assert!(matches!(&h.app.actions()[..], [PlatformAction::UseDownload(_, SavedAction::Open, target)]
+        if target.entry == "review-file"));
+    assert!(h.app.root.menu.is_none());
+    assert!(h.app.root.dialog.is_none());
+}
+
+#[test]
+fn review_folder_and_attachment_header_controls_have_equal_idle_chrome() {
+    let mut h = Harness::new();
+    h.frame();
+    let controls = &h.app.root.workspace.chat.header.controls.items;
+    let folder = controls.iter().find(|(_, _, c)| matches!(c, header::Choice::Files)).unwrap().1.control.rect.unwrap();
+    let attachment = controls.iter().find(|(_, _, c)| matches!(c, header::Choice::Attachments)).unwrap().1.control.rect.unwrap();
+    let sample = |r: sanscale::Rect| sanscale::Vec2::new(r.x + r.width / 2., r.y + 3.);
+    let image = h.ctx.read_rgba8().unwrap();
+    assert_eq!(pixel(&image, sample(folder)), pixel(&image, sample(attachment)),
+        "sibling nonprimary header actions should use the same explicit idle button style");
+}
+
+#[test]
+fn review_stationary_drag_extends_selection_as_transcript_autoscrolls() {
+    let mut h = Harness::new();
+    let mut event = h.app.controller.chats["demo"].feed.events.values().next().unwrap().clone();
+    event.id = "review-long-text".into();
+    event.entry_id = event.id.clone();
+    event.order = 1;
+    event.attachment = None;
+    event.text = (0..120).map(|i| format!("Selectable review paragraph {i:03}.\n\n")).collect();
+    let chat = h.app.controller.chats.get_mut("demo").unwrap();
+    chat.feed.events.clear();
+    chat.feed.events.insert(1, event);
+    chat.local.position.follow = false;
+    chat.local.position.key = None;
+    h.frame();
+    let viewport = h.app.root.workspace.chat.transcript.scroll.rect;
+    let start = sanscale::Vec2::new(viewport.x + 70., viewport.y + 80.);
+    let end = sanscale::Vec2::new(start.x, viewport.y + viewport.height - 2.);
+    h.app.press(1, start, false);
+    h.app.motion(1, end);
+    assert!(h.app.root.workspace.chat.transcript.selecting);
+    let before = h.app.services.renderer.selection.as_ref().unwrap().focus.clone();
+    let old_scroll = h.app.root.workspace.chat.transcript.scroll.value;
+    for _ in 0..16 {
+        h.app.ui_event(Event::Tick(0.05));
+        h.frame();
+    }
+    assert!(h.app.root.workspace.chat.transcript.scroll.value > old_scroll + 100.);
+    let under_pointer = h.app.services.renderer.nearest_text(end).unwrap();
+    assert!(under_pointer.byte > before.byte, "the viewport now exposes later text");
+    let focus = &h.app.services.renderer.selection.as_ref().unwrap().focus;
+    assert_eq!((&focus.key, focus.byte), (&under_pointer.key, under_pointer.byte),
+        "a held, stationary pointer must extend the selection after autoscroll layout");
+}
