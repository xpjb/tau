[Unit]
Description=Tau 2 beta native Rust agent (isolated from stable)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/root/.cargo/bin:/usr/local/sbin:/usr/bin
Environment=TAU_BIND=127.0.0.1:8791
Environment=TAU_TRANSFER_BIND=127.0.0.1:8792
Environment=RUST_LOG=info
Environment=TOKIO_WORKER_THREADS=2
Environment=CARGO_BUILD_JOBS=1
Environment=RAYON_NUM_THREADS=1
Environment=TAU_CWD=/root
Environment=TAU_DATABASE_PATH=/var/lib/tau2-beta/tau.sqlite3
Environment=TAU_TELEMETRY_PATH=/var/lib/tau2-beta/client-crashes.jsonl
Environment=TAU_SETTINGS_PATH=/var/lib/tau2-beta/settings.json
Environment=TAU_ATTACHMENT_ROOT=/root/.local/share/tau2-beta/outbox
Environment=TAU_UPLOAD_ROOT=/root/.local/share/tau2-beta/uploads
EnvironmentFile=/etc/tau2-beta.env
ExecStart=/usr/local/lib/tau2-beta/taud
Restart=on-failure
RestartSec=5s
TimeoutStopSec=75s
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
